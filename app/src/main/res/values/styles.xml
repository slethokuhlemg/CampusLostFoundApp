<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="Theme.CampusLostFound"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:fontFamily">sans-serif</item>

        <!-- BLUE THEME (matches presentation screenshots) -->

        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryDark">@color/brand_blue_dark</item>
        <item name="colorOnPrimary">@color/surface_white</item>
        <item name="colorSecondary">@color/brand_sky_blue</item>

        <item name="colorPrimaryContainer">@color/brand_green_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_blue_dark</item>
        <item name="colorSecondaryContainer">@color/brand_green_pale</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <!-- Error -->
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/surface_white</item>

        <!-- Surfaces (cards, dialogs, menus) and text -->
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_grey</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainer">@color/surface_white</item>
        <item name="colorSurfaceContainerHigh">@color/surface_white</item>
        <item name="colorSurfaceContainerHighest">@color/surface_white</item>
        <item name="colorOutline">@color/text_secondary</item>
        <item name="colorOutlineVariant">@color/border_grey</item>

        <!-- Screen background -->
        <item name="android:colorBackground">@color/home_background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:windowBackground">@color/home_background</item>

        <!-- Status bar -->

        <item name="android:statusBarColor">@color/brand_blue_dark</item>

        <item name="android:windowLightStatusBar">false</item>

        <!-- Prevent Android 15 edge-to-edge from placing app content
             underneath the system notification/status bar -->

        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>

    </style>


    <!-- Filled blue button -->

    <style name="ButtonFilled">

        <item name="android:layout_width">match_parent</item>

        <item name="android:layout_height">54dp</item>

        <item name="android:background">@drawable/bg_button_filled</item>

        <item name="android:textColor">@color/surface_white</item>

        <item name="android:textAllCaps">false</item>

        <item name="android:textSize">16sp</item>

        <item name="android:textStyle">bold</item>

        <item name="android:elevation">0dp</item>

        <item name="android:stateListAnimator">@null</item>

    </style>


    <!-- Outlined button -->

    <style name="ButtonOutline">

        <item name="android:layout_width">match_parent</item>

        <item name="android:layout_height">54dp</item>

        <item name="android:background">@drawable/bg_button_outline</item>

        <item name="android:textColor">@color/brand_blue</item>

        <item name="android:textAllCaps">false</item>

        <item name="android:textSize">16sp</item>

        <item name="android:textStyle">bold</item>

        <item name="android:elevation">0dp</item>

        <item name="android:stateListAnimator">@null</item>

    </style>


    <!-- Rounded input field -->

    <style name="InputRounded">

        <item name="android:layout_width">match_parent</item>

        <item name="android:layout_height">54dp</item>

        <item name="android:background">@drawable/bg_input</item>

        <item name="android:paddingStart">16dp</item>

        <item name="android:paddingEnd">16dp</item>

        <item name="android:textColor">@color/text_primary</item>

        <item name="android:textColorHint">@color/text_secondary</item>

        <item name="android:textSize">15sp</item>

    </style>

</resources>