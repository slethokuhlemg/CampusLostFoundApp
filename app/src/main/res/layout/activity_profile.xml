<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/profileBackButton"
            android:text="← Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="My Profile"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/brand_green_dark"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Your account information"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/profileNameText"
            android:text="Name not available"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/brand_green_dark"
            android:layout_marginTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/profileStudentNumberText"
            android:text="Student Number: Not available"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/profileEmailText"
            android:text="Email: Not available"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/profilePhoneText"
            android:text="Phone: Not available"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_grey"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/profileLogoutButton"
            style="@style/ButtonOutline"
            android:text="Logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</ScrollView>